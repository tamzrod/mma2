    {
        "id": "4de62cf1beff51f4",
        "type": "function",
        "z": "3da0cd72f1f921d3",
        "name": "function 6",
        "func": "const VERSION = 0x01;\nconst UNIT_ID = 1;\nconst START_ADDR = 100;\nconst COUNT = 1;\n\nfunction buildPacket(area, dataBuf) {\n    const header = Buffer.alloc(10);\n\n    header[0] = 0x52; // 'R'\n    header[1] = 0x49; // 'I'\n    header[2] = VERSION;\n    header[3] = area;\n\n    header.writeUInt16BE(UNIT_ID, 4);\n    header.writeUInt16BE(START_ADDR, 6);\n    header.writeUInt16BE(COUNT, 8);\n\n    return Buffer.concat([header, dataBuf]);\n}\n\n// Holding register write (Area = 3)\nlet holdingBuf = Buffer.alloc(2);\nholdingBuf.writeUInt16BE(1234, 0);\n\nnode.send({\n    area: \"holding_registers\",\n    payload: buildPacket(3, holdingBuf)\n});\n\nreturn null;",
